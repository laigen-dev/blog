---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '关于 AI 手机、知识库与效率工具的个人记录。'
} = Astro.props;

const pageTitle = title === '首页' ? 'laigen' : `${title} · laigen`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">laigen</a>
        <nav>
          <a href="/">文章</a>
          <a href="/about/">关于</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <p>© {new Date().getFullYear()} laigen · <a href="/about/">关于本站</a></p>
      </div>
    </footer>
  </body>
</html>
